DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 to use sqlite (handy for quick local runs without Docker).
# Leave 0 (default) to use PostgreSQL via DB_* variables below.
USE_SQLITE=0

DB_NAME=location_map
DB_USER=location_map
DB_PASSWORD=location_map
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1

# Console backend by default — prints emails to stdout/logs instead of sending them.
# Switch to django.core.mail.backends.smtp.EmailBackend + SMTP_* vars for real sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@location-map.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1

FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
